import os
import numpy as np

sphere_location = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Scene_parts", "CollisionSphere.stl")
print("file found:", os.path.exists(sphere_location))

data = open(sphere_location, "rb").read()
triangle_count = int(np.frombuffer(data[80:84], dtype=np.uint32)[0])
if len(data) == 84 + triangle_count * 50: #binary stl
    triangles = np.frombuffer(data[84:], dtype=np.dtype([("n", "<f4", 3), ("v", "<f4", (3, 3)), ("a", "<u2")]))
    points = triangles["v"].reshape(-1, 3)
else: #text stl
    points = np.array([line.split()[1:4] for line in data.decode(errors="ignore").splitlines() if line.strip().startswith("vertex")], dtype=float)
print("smallest x y z:", np.round(points.min(axis=0), 4))
print("biggest x y z: ", np.round(points.max(axis=0), 4))